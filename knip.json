{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["**/dist/**", "tooling/otel-runtime/**"],
  "ignoreBinaries": ["oxlint", "treefmt"],
  "workspaces": {
    "apps/admin": {
      "entry": ["src/routes/**/*.ts", "src/routes/**/*.tsx"],
      "ignoreDependencies": ["@img/sharp-wasm32"]
    },
    "apps/web": {
      "entry": ["src/routes/**/*.ts", "src/routes/**/*.tsx"]
    },
    "packages/core": {
      "entry": [
        "src/api/Api.ts",
        "src/api/client.ts",
        "src/api/handlers.ts",
        "src/config.ts",
        "src/domain/*.ts",
        "src/http/*.ts",
        "src/images/policy.ts",
        "src/runtime.ts",
        "src/services/*.ts"
      ]
    },
    "packages/database": {
      "entry": ["src/index.ts", "src/client.ts", "src/enums.ts"]
    },
    "packages/react": {
      "entry": ["src/styles/*.css"]
    },
    ".": {
      "entry": ["scripts/*.ts"]
    }
  }
}
