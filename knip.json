{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/admin": {
      "entry": ["src/router.tsx", "src/server.ts", "src/routes/**/*.ts", "src/routes/**/*.tsx"],
      "ignoreDependencies": ["@img/sharp-wasm32"]
    },
    "apps/web": {
      "entry": ["src/router.tsx", "src/server.ts", "src/routes/**/*.ts", "src/routes/**/*.tsx"]
    },
    "packages/core": {
      "entry": [
        "src/api/index.ts",
        "src/auth/index.ts",
        "src/http/readiness.ts",
        "src/http/request-body.ts",
        "src/http/runtime-url.ts",
        "src/http/security.ts",
        "src/images/policy.ts",
        "src/storage/s3.ts",
        "src/telemetry/tracing.ts",
        "scripts/auth-cli.ts"
      ]
    },
    "packages/database": {
      "entry": ["src/index.ts", "src/client.ts"]
    },
    "packages/react": {
      "entry": ["src/styles/*.css"]
    },
    "docker/runtime": {
      "entry": ["*.mjs"],
      "ignoreDependencies": ["pg"]
    },
    ".": {
      "entry": ["scripts/*.ts"]
    }
  }
}
