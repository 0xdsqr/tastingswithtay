{
  "name": "@twt/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./*": {
      "import": "./dist/esm/*.js",
      "types": "./dist/types/*.d.ts"
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "clean": "bun ../../scripts/clean.ts packages/database",
    "studio": "drizzle-kit studio",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "typecheck": "tsc --noEmit",
    "typecheck:ts6": "tsc6 --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "0.8.3",
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@twt/tsconfig": "workspace:*",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10"
  }
}
