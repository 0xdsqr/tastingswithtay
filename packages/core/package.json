{
  "name": "@twt/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./auth": {
      "import": "./dist/esm/auth/index.js",
      "types": "./dist/types/auth/index.d.ts"
    },
    "./api": {
      "import": "./dist/esm/api/index.js",
      "types": "./dist/types/api/index.d.ts"
    },
    "./*": {
      "import": "./dist/esm/*.js",
      "types": "./dist/types/*.d.ts"
    }
  },
  "scripts": {
    "auth:generate": "bunx @better-auth/cli@1.6.23 generate --config scripts/auth-cli.ts --output ../db/src/auth-schema.ts",
    "build": "bun run scripts/build.ts",
    "clean": "bun ../../scripts/clean.ts packages/core",
    "typecheck": "tsc --noEmit",
    "typecheck:ts6": "tsc6 --noEmit"
  },
  "dependencies": {
    "@trpc/server": "11.18.0",
    "@twt/db": "workspace:*",
    "better-auth": "1.6.23",
    "effect": "3.22.0",
    "superjson": "2.2.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@twt/tsconfig": "workspace:*"
  }
}
