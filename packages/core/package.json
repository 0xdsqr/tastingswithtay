{
  "name": "@twt/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "import": "./dist/esm/*.js",
      "types": "./dist/types/*.d.ts"
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "clean": "bun ../../scripts/clean.ts packages/core",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1175.0",
    "@effect/opentelemetry": "4.1.5",
    "@opentelemetry/api": "1.10.0",
    "@twt/database": "workspace:*",
    "better-auth": "1.7.27",
    "effect": "4.1.5"
  },
  "devDependencies": {
    "@twt/tsconfig": "workspace:*"
  }
}
