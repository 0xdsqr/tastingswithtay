{
  "name": "tastingswithtay",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/typescript"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run build:packages && bun run build:apps",
    "build:apps": "bun run --filter './apps/*' build",
    "build:packages": "bun run --filter '@twt/database' build && bun run --filter '@twt/core' build",
    "check": "bun run format:check && bun run lint && bun run build:packages && bun run typecheck && bun run typecheck:ts6 && bun run test && bun run deps:check && bun run audit && bun run build:apps",
    "db:studio": "bun run --filter '@twt/database' studio",
    "db:generate": "bun run --filter '@twt/database' generate",
    "dev:admin": "bun run --filter 'admin' dev",
    "dev:web": "bun run --filter 'web' dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint -c .oxlintrc.jsonc . --deny-warnings",
    "lint:fix": "oxlint -c .oxlintrc.jsonc --fix .",
    "typecheck": "bun run --filter './apps/*' --filter './packages/*' typecheck",
    "typecheck:ts6": "bun run --filter './apps/*' --filter './packages/*' typecheck:ts6",
    "test": "vitest run",
    "audit": "bun run scripts/audit.ts",
    "deps:check": "knip",
    "clean": "bun run scripts/clean.ts"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.4",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@typescript/typescript6": "6.0.2",
    "knip": "6.45.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "picomatch": "4.0.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@babel/core": "7.29.13",
    "esbuild": "0.28.1",
    "js-yaml": "4.3.2",
    "kysely": "0.28.17",
    "undici": "7.28.0",
    "vite": "8.3.8"
  },
  "engines": {
    "bun": "1.4.4",
    "node": "26.x"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "picomatch@4.0.7": "patches/picomatch@4.0.7.patch"
  }
}
