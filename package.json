{
  "name": "tastingswithtay",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/typescript"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter '@twt/database' build && bun run --filter '@twt/core' build && bun run --filter './apps/*' build",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "db:studio": "bun run --filter '@twt/database' studio",
    "db:generate": "bun run --filter '@twt/database' generate",
    "dev:admin": "bun run --filter 'admin' dev",
    "dev:web": "bun run --filter 'web' dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint -c .oxlintrc.jsonc . --deny-warnings",
    "lint:fix": "oxlint -c .oxlintrc.jsonc --fix .",
    "typecheck": "bun run --filter './apps/*' --filter './packages/*' typecheck",
    "typecheck:ts6": "bun run --filter './apps/*' --filter './packages/*' typecheck:ts6",
    "test": "vitest run",
    "audit": "bun audit --audit-level=high",
    "deps:check": "knip",
    "clean": "bun run scripts/clean.ts"
  },
  "devDependencies": {
    "@effect/vitest": "0.30.0",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.1",
    "@typescript/typescript6": "6.0.2",
    "knip": "6.26.0",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "typescript": "7.0.2",
    "vitest": "3.2.7"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "esbuild": "0.28.1",
    "js-yaml": "4.3.0",
    "kysely": "0.28.17",
    "undici": "7.28.0",
    "vite": "7.3.5"
  },
  "engines": {
    "bun": "1.3.13",
    "node": "24.x"
  },
  "packageManager": "bun@1.3.13"
}
